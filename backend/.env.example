# MongoDB Atlas Connection URI (required for persistence and caching)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name
MONGODB_DB_NAME=elibrary

# WEKA JVM Heap size (192m is recommended for Render 512MB free tier)
WEKA_HEAP=192m
